# This repo is edited on Windows but may be cloned and run on Linux or macOS.
# A CRLF that reaches a POSIX shell shows up as a trailing \r on every command
# — "uvicorn\r: not found" and similar. Force LF on everything a shell or
# parser touches.

* text=auto eol=lf

*.py         text eol=lf
*.sh         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.txt        text eol=lf

# Binaries git must never touch.
*.png binary
*.jpg binary
