# Copy to .env and fill in real values. .env is gitignored — keep it that way.
# In production these are NOT read from a file: the backend reads them from
# Hugging Face Space secrets, and the frontend reads VITE_API_URL from Vercel.

# ── Groq (LLM inference) ─────────────────────────────────────────────────────
GROQ_API_KEY="gsk_..."

# Optional model overrides. Groq retires model IDs on its own schedule; these
# let you patch a retirement without a code change.
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_ANSWER_MODEL=openai/gpt-oss-120b

# ── Neon Postgres (pgvector store) ───────────────────────────────────────────
# Individual parts — used by retrieval.py and bm25_retrieval.py.
DB_HOST=ep-xxxx-xxxx.region.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=npg_...

# Full connection string — used by ingest.py. Neon requires SSL.
DATABASE_URL=postgresql://neondb_owner:npg_...@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ── Cross-origin ─────────────────────────────────────────────────────────────
# Deployed frontend origin(s), comma-separated, no trailing slash.
# Set this on the Hugging Face Space, not here.
FRONTEND_URL=https://rahbar.craftwyre.com

# ── Frontend ─────────────────────────────────────────────────────────────────
# Local dev points at the local backend. On Vercel this is set to the Space URL.
VITE_API_URL=http://localhost:8000

# ── Runtime paths (production only) ──────────────────────────────────────────
# BM25_INDEX_PATH=/home/user/app/bm25_index.pkl
