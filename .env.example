# Copy to .env in the project root and fill in real values.
# .env is gitignored — keep it that way.

# ── Groq (LLM inference) ─────────────────────────────────────────────────────
GROQ_API_KEY="gsk_..."

# Optional model overrides. Groq retires model IDs on its own schedule; these
# let you patch a retirement without a code change.
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_ANSWER_MODEL=openai/gpt-oss-120b

# ── HuggingFace ──────────────────────────────────────────────────────────────
# Optional. Avoids anonymous rate limits when the embedding model and reranker
# are downloaded on first run.
HF_TOKEN="hf_..."

# ── Postgres + pgvector (vector store) ───────────────────────────────────────
# Individual parts — used by retrieval.py and bm25_retrieval.py.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rahbar_ai
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Full connection string — used by ingest.py.
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/rahbar_ai
# A hosted Postgres (Neon, Supabase, RDS) works too and generally requires SSL:
# DATABASE_URL=postgresql://user:pass@host.neon.tech/neondb?sslmode=require

# ── Frontend ─────────────────────────────────────────────────────────────────
# Where the Vite dev server should reach the backend.
VITE_API_URL=http://localhost:8000

# ── Cross-origin (optional) ──────────────────────────────────────────────────
# localhost:3000 and localhost:5173 are always allowed. Set this only if you
# serve the frontend from some other origin. Comma-separated, no trailing slash.
# FRONTEND_URL=http://192.168.1.20:5173

# ── Runtime paths (optional) ─────────────────────────────────────────────────
# Where the BM25 index is cached. Defaults to backend/bm25_index.pkl.
# BM25_INDEX_PATH=./bm25_index.pkl
